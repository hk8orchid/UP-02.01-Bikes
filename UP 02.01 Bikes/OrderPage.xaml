<Page x:Class="UP_02._01_Bikes.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP_02._01_Bikes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Заказы">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="BtnAddOrder" Content="Добавить заказ" Width="150" Height="30"
                HorizontalAlignment="Left" Margin="0,0,0,10"
                Click="BtnAddOrder_Click" Visibility="Collapsed"/>

        <ListView x:Name="LvOrders" Grid.Row="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="5" Width="400"
                            MouseLeftButtonUp="Border_MouseLeftButtonUp" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="8">
                                <TextBlock Text="{Binding Articul}" FontWeight="Bold"/>
                                <TextBlock>
                                <Run Text="Статус: "/>
                                <Run Text="{Binding Status}"/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                <Run Text="Адрес пункта выдачи: "/>
                                <Run Text="{Binding Address}"/>
                                </TextBlock>
                                <TextBlock>
                                <Run Text="Дата заказа: "/>
                                <Run Text="{Binding OrderDate}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1"
                                    Margin="5" Padding="5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrderDelivery, StringFormat=Дата доставки: {0:dd.MM.yyyy}}"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
