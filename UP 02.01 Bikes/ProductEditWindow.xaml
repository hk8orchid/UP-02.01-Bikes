<Window x:Class="UP_02._01_Bikes.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP_02._01_Bikes"
        mc:Ignorable="d"
        Title="ProductEditWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Image x:Name="ImgPhoto" Width="300" Height="200" Stretch="Uniform" 
                   Source="pictures/picture.png" Margin="0,0,0,5"/>
            <Button Content="Сменить фото" Width="150" Click="BtnChangePhoto_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbId" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Visibility="Collapsed"/>
            
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbName" Grid.Row="1" Grid.Column="1"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Категория:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbCategory" Grid.Row="2" Grid.Column="1"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Описание:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbDescription" Grid.Row="3" Grid.Column="1" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Производитель:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbManufacturer" Grid.Row="4" Grid.Column="1"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Поставщик:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbProvider" Grid.Row="5" Grid.Column="1"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Цена:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbPrice" Grid.Row="6" Grid.Column="1" PreviewTextInput="NumberOnly_PreviewTextInput"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ед. измерения:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbMeasureUnit" Grid.Row="7" Grid.Column="1" IsReadOnly="True"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Количество:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbQuantity" Grid.Row="8" Grid.Column="1" PreviewTextInput="NumberOnly_PreviewTextInput"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Скидка (%):" VerticalAlignment="Center"/>
            <TextBox x:Name="TbDiscount" Grid.Row="9" Grid.Column="1" PreviewTextInput="NumberOnly_PreviewTextInput"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="100" Margin="5" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="100" Margin="5" Click="BtnCancel_Click"/>
            <Button x:Name="BtnDelete" Content="Удалить" Width="100" Margin="5" Background="Red" Foreground="White" 
                    Click="BtnDelete_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>

</Window>
