<Page x:Class="UP_02._01_Bikes.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP_02._01_Bikes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список товаров">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="SpControls" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="TbSearch" Width="200" Height="30" 
                 VerticalContentAlignment="Center"
                 TextChanged="TbSearch_TextChanged"/>

            <ComboBox x:Name="CbSort" Width="200" Height="30" Margin="10,0"
                  SelectionChanged="CbSort_SelectionChanged">
                <ComboBoxItem Content="По умолчанию"/>
                <ComboBoxItem Content="Цена ↑"/>
                <ComboBoxItem Content="Цена ↓"/>
                <ComboBoxItem Content="Скидка ↑"/>
                <ComboBoxItem Content="Скидка ↓"/>
                <ComboBoxItem Content="Остаток ↑"/>
                <ComboBoxItem Content="Остаток ↓"/>
            </ComboBox>

            <ComboBox x:Name="CbFilter" Width="200" Height="30"
                  SelectionChanged="CbFilter_SelectionChanged">
                <ComboBoxItem Content="Все диапазоны скидок"/>
                <ComboBoxItem Content="0 - 11,99%"/>
                <ComboBoxItem Content="12 - 18,99%"/>
                <ComboBoxItem Content="19% и более"/>
            </ComboBox>

            <Button x:Name="BtnAddProduct" Content="Добавить товар" Width="150" Height="30" 
                    Margin="10,0,0,0" Click="BtnAddProduct_Click" Visibility="Collapsed"/>
        </StackPanel>
        
        <ListView x:Name="LvProducts" Grid.Row="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding CardBackground}" 
                            BorderBrush="Black" BorderThickness="1"
                            MouseLeftButtonUp="Border_MouseLeftButtonUp"
                            Margin="5" Width="400">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" 
                                   Source="{Binding PhotoPath}" 
                                   Width="140" Height="140" 
                                   Stretch="Uniform"/>

                            <StackPanel Grid.Column="1" Margin="5">
                                <TextBlock FontWeight="Bold">
                                    <Run Text="{Binding Category}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>

                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>

                                <TextBlock>
                                    <Run Text="Производитель: " FontWeight="Bold"/>
                                    <Run Text="{Binding Manufacturer}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Поставщик: " FontWeight="Bold"/>
                                    <Run Text="{Binding Provider}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Цена: " FontWeight="Bold"/>
                                    <Run Text="{Binding Price, StringFormat={}{0:F2}}" 
                                         Foreground="Red" 
                                         TextDecorations="Strikethrough"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding DiscountPrice, StringFormat={}{0:F2}}" 
                                         Foreground="Black"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Единица измерения: " FontWeight="Bold"/>
                                    <Run Text="{Binding MeasureUnit}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Количество на складе: " FontWeight="Bold"/>
                                    <Run Text="{Binding Quantity}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="2" 
                                    BorderBrush="Black" BorderThickness="1"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Padding="5">
                                <TextBlock Text="{Binding Discount, StringFormat={}{0}%}" 
                                           FontSize="16" FontWeight="Bold"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
